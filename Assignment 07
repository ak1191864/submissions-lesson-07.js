}
function PlaceMove(k) {
  k.putBeeper();
  k.move();
  k.putBeeper();
  k.move();
  k.putBeeper();
  k.move();
  k.putBeeper();
  k.move();
  k.putBeeper();
  turnAround(k);
  k.move();
  k.move();
  k.move();
  k.move();
  turnAround(k);
}
function main(k) {
  k.turnLeft();
  drawBar(k, 2);
