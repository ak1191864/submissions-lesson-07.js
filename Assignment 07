// Problem 3: complex (Difficult)
// ──────────────────────────────────────────────────────────
function problem_3() {
function turnRight(k) {
    for (let i = 0; i < 3; i++) {
        k.turnLeft();
    }
}

function turnAround(k) {
    k.turnLeft();
    k.turnLeft();
}

function paintN(k, c, n) {
    for (let i = 0; i < n; i++) {
        k.paintCorner(c);
        if (i < n - 1) {
            k.move();
        }
    }
}

function main(k) {
    // Red bottom
    paintN(k, "Red", 5);

    // Face north
    k.turnLeft();

    // Blue right
    paintN(k, "Blue", 4);

    // Face west
    k.turnLeft();

    // Green top
    paintN(k, "Green", 5);

    // Face south
    k.turnLeft();

    // Yellow left
    paintN(k, "Yellow", 3);
}
  return main;
}

